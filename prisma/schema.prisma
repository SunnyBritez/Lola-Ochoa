generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  salePrice   Float?
  imageUrl    String?
  category    String   @default("ZAPATOS")
  stock       Int      @default(0) // Stock general (opcional si usamos variants)
  variants    Json?    // Guarda array de { size: '36', color: 'Negro', stock: 5 }
  isLook      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  orderItems  OrderItem[]
}

model Order {
  id            String   @id @default(cuid())
  customerName  String
  customerEmail String
  customerPhone String?
  address       String?
  zipCode       String?
  totalAmount   Float
  status        String   @default("PENDING") // PENDING, PAID, SHIPPED, CANCELLED
  mpPreferenceId String? // MercadoPago Preference ID
  mpPaymentId   String?  // MercadoPago Payment ID
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  items         OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  quantity  Int
  price     Float
  
  // Relations
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
